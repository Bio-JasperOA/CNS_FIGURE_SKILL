{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Logic Plan",
  "type": "object",
  "required": ["project", "gap", "claims", "data_design", "analysis_chain", "validation_ladder", "failure_modes", "figure_story"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title", "biological_question", "central_claim", "study_pattern"],
      "properties": {
        "title": {"type": "string", "minLength": 5},
        "biological_question": {"type": "string", "minLength": 15},
        "central_claim": {"type": "string", "minLength": 15},
        "study_pattern": {
          "enum": ["atlas_discovery", "development_embryo", "spatial_ecology", "foundation_model", "perturbation_causal", "multimodal_bridge", "hybrid"]
        },
        "example_only": {"type": "boolean"}
      }
    },
    "gap": {
      "type": "object",
      "required": ["known", "missing", "why_existing_work_is_insufficient", "why_now"],
      "properties": {
        "known": {"type": "string"},
        "missing": {"type": "string"},
        "why_existing_work_is_insufficient": {"type": "string"},
        "why_now": {"type": "string"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "claim", "level", "evidence", "failure_rule"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "claim": {"type": "string", "minLength": 10},
          "level": {
            "enum": ["descriptive", "comparative", "predictive", "mechanistic", "causal", "generalization", "translational"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["data", "analysis_or_experiment", "expected_observation", "alternative_explanation", "validation"],
              "properties": {
                "data": {"type": "string"},
                "analysis_or_experiment": {"type": "string"},
                "expected_observation": {"type": "string"},
                "alternative_explanation": {"type": "string"},
                "validation": {"type": "string"}
              }
            }
          },
          "failure_rule": {"type": "string", "minLength": 10}
        }
      }
    },
    "data_design": {
      "type": "object",
      "required": ["modalities", "biological_replicate_unit", "discovery_set", "validation_set", "independence_unit", "leakage_barriers"],
      "properties": {
        "modalities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "biological_replicate_unit": {"type": "string"},
        "discovery_set": {"type": "string"},
        "validation_set": {"type": "string"},
        "independence_unit": {"type": "string"},
        "time_axis": {"type": "string"},
        "space_axis": {"type": "string"},
        "perturbation_axis": {"type": "string"},
        "ood_axes": {"type": "array", "items": {"type": "string"}},
        "leakage_barriers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "analysis_chain": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["step", "purpose", "input", "method_family", "output", "supports_claims", "failure_rule"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 8},
          "input": {"type": "string"},
          "method_family": {"type": "string"},
          "output": {"type": "string"},
          "supports_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}},
          "failure_rule": {"type": "string"}
        }
      }
    },
    "model_evaluation": {
      "type": "object",
      "properties": {
        "baselines": {"type": "array", "items": {"type": "string"}},
        "split_strategy": {"type": "string"},
        "ood_axes": {"type": "array", "items": {"type": "string"}},
        "ablations": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "string"},
        "leakage_audit": {"type": "string"},
        "biological_utility_test": {"type": "string"}
      }
    },
    "validation_ladder": {
      "type": "object",
      "required": ["internal", "external_or_ood", "orthogonal"],
      "properties": {
        "internal": {"type": "string"},
        "external_or_ood": {"type": "string"},
        "orthogonal": {"type": "string"},
        "perturbational": {"type": "string"},
        "experimental": {"type": "string"},
        "negative_controls": {"type": "array", "items": {"type": "string"}}
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["risk", "diagnostic", "response"],
        "properties": {
          "risk": {"type": "string"},
          "diagnostic": {"type": "string"},
          "response": {"type": "string"}
        }
      }
    },
    "figure_story": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["figure", "question", "claim", "panels"],
        "properties": {
          "figure": {"type": "string"},
          "question": {"type": "string"},
          "claim": {"type": "string"},
          "panels": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "minimal_publishable_version": {"type": "string"},
        "ambitious_extension": {"type": "string"}
      }
    }
  }
}