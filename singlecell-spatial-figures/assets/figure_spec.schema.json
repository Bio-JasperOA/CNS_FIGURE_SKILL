{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Single-cell/spatial FigureSpec 2.0",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "2.0"
    },
    "figure": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "main_message": {
          "type": "string",
          "minLength": 1
        },
        "evidence_level": {
          "enum": [
            "descriptive",
            "association",
            "prediction",
            "intervention"
          ]
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "question",
        "main_message",
        "evidence_level",
        "width_mm",
        "height_mm"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "fallback_font": {
          "type": "string",
          "minLength": 1
        },
        "font_pt": {
          "type": "number",
          "minimum": 5
        },
        "min_font_pt": {
          "type": "number",
          "minimum": 5
        },
        "tag_pt": {
          "type": "number",
          "minimum": 5
        },
        "line_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "panel_padding_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "font_family",
        "fallback_font",
        "font_pt",
        "min_font_pt",
        "tag_pt",
        "line_pt",
        "panel_padding_mm"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "row_weights": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1
        },
        "col_weights": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1
        },
        "gap_mm": {
          "type": "number",
          "minimum": 0
        },
        "margin_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "rows",
        "cols",
        "row_weights",
        "col_weights",
        "gap_mm",
        "margin_mm"
      ],
      "additionalProperties": false
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "grain": {
            "enum": [
              "cell",
              "spot",
              "donor_summary",
              "matrix",
              "edge",
              "trend",
              "metrics"
            ]
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "value_definition": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "grain",
          "keys",
          "value_definition",
          "source"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "scales": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "continuous"
              },
              "limits": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "cmap": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "limits",
              "label",
              "cmap"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "categorical"
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "colors": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "order",
              "colors",
              "label"
            ],
            "additionalProperties": false
          }
        ]
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "overview",
              "identity",
              "spatial_context",
              "quantification",
              "mechanism_candidate",
              "validation",
              "benchmark",
              "uncertainty"
            ]
          },
          "renderer": {
            "type": "string",
            "minLength": 1
          },
          "data_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "slot": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "scale_ids": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          },
          "comparison_group": {
            "type": "string",
            "minLength": 1
          },
          "statistics": {
            "type": "object",
            "properties": {
              "inferential": {
                "type": "boolean"
              },
              "independent_unit": {
                "enum": [
                  "none",
                  "donor",
                  "animal",
                  "biological_sample",
                  "cell",
                  "spot"
                ]
              },
              "n_biological": {
                "type": "integer",
                "minimum": 0
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "source_table": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "inferential",
              "independent_unit",
              "n_biological",
              "method"
            ],
            "additionalProperties": false
          },
          "spatial": {
            "type": "object",
            "properties": {
              "unit": {
                "enum": [
                  "um",
                  "pixel"
                ]
              },
              "y_axis_down": {
                "type": "boolean"
              },
              "section_column": {
                "type": "string",
                "minLength": 1
              },
              "transform_applied": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "unit",
              "y_axis_down",
              "section_column",
              "transform_applied"
            ],
            "additionalProperties": false
          },
          "padding_mm": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "question",
          "role",
          "renderer",
          "data_id",
          "slot",
          "channels",
          "scale_ids",
          "depends_on",
          "statistics"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "spec_version",
    "figure",
    "design",
    "layout",
    "datasets",
    "scales",
    "panels"
  ],
  "additionalProperties": false
}
